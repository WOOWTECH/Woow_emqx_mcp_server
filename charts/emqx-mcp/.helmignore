# Patterns to ignore when building Helm packages.
.DS_Store
.git/
.gitignore
.github/
.helmignore
*.tgz
*.bak
*.tmp
*.swp
.idea/
.vscode/
README*.md
examples/
scripts/
# Anchored on purpose: an unanchored "deploy/" would also match any future
# templates/deploy/ and silently drop it from the package. Per-cluster instance
# values are passed with -f, never packaged.
/deploy/
# Never add an unanchored "tests/": templates/tests/smoke.yaml is the `helm
# test` hook and must stay in the package.
